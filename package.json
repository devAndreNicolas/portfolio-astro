{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:all": "pnpm cv:build && pnpm build",
    "preview": "astro preview",
    "astro": "astro",
    "cv": "node scripts/cv.mjs",
    "cv:list": "node scripts/cv.mjs list",
    "cv:build": "node scripts/cv.mjs build",
    "cv:publish": "node scripts/sync-public-cvs.mjs",
    "cv:content:check": "node scripts/validate-cv-content.mjs",
    "cv:check": "node scripts/validate-cv.mjs && pnpm cv:content:check",
    "cv:verify": "node scripts/validate-cv.mjs --require-pdfs && pnpm cv:content:check",
    "cv:clean": "node scripts/cv.mjs clean",
    "applications:analyze": "node scripts/analyze-applications.mjs --write",
    "applications:report": "node scripts/analyze-applications.mjs",
    "career:cv-fit": "node scripts/audit-cv-role-fit.mjs --write",
    "career:dashboard": "node scripts/generate-career-dashboard.mjs",
    "career:report": "node scripts/generate-career-operations-report.mjs",
    "career:verify": "node scripts/validate-career-operation.mjs",
    "profile:audit": "node scripts/audit-public-profile.mjs",
    "applications:test": "node --test scripts/analyze-applications.test.mjs",
    "roles:recommend": "node scripts/recommend-roles.mjs --write",
    "roles:test": "node --test scripts/recommend-roles.test.mjs",
    "jobs:searches": "node scripts/generate-job-searches.mjs",
    "jobs:collect": "node scripts/collect-jobs.mjs --provider=both",
    "jobs:collect:br": "node scripts/collect-jobs.mjs --provider=both --limit 10",
    "jobs:collect:remote": "node scripts/collect-jobs.mjs --provider=both --remote --limit 10",
    "jobs:collect:google": "node scripts/collect-jobs.mjs --provider=serpapi --limit 10",
    "jobs:collect:serper": "node scripts/collect-jobs.mjs --provider=serper --limit 10",
    "validate": "pnpm cv:check && pnpm build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^5.17.1"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
