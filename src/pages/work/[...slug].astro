---
import { type CollectionEntry, getCollection, render } from "astro:content";

import ContactCTA from "../../components/ContactCTA.astro";
import Hero from "../../components/Hero.astro";
import Icon from "../../components/Icon.astro";
import TechBadge from "../../components/TechBadge.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"work">;
}

// This is a dynamic route that generates a page for every Markdown file in src/content/
// Read more about dynamic routes and this `getStaticPaths` function in the Astro docs:
// https://docs.astro.build/en/guides/routing/#dynamic-routes
export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="stack gap-20">
    <div class="stack gap-15">
      <header>
        <div class="wrapper stack gap-2">
          <a class="back-link" href="/work/"><Icon icon="arrow-left" /> Work</a>
          <Hero title={entry.data.title} align="start">
            <div class="details">
              <div class="tags">
                {entry.data.tags.map((t) => <TechBadge tech={t} />)}
              </div>
              <p class="description">{entry.data.description}</p>
            </div>
          </Hero>
        </div>
      </header>
      <main class="wrapper">
        <div class="stack gap-10 content">
          {
            entry.data.img && (
              <img src={entry.data.img} alt={entry.data.img_alt || ""} />
            )
          }
          <div class="content">
            <Content />
          </div>
        </div>
      </main>
    </div>
    <ContactCTA />
  </div>
</BaseLayout>

<style>
  header {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--gray-800);
  }

  /* BACK-LINK: Responsivo ao tema */
  .back-link {
    display: none; /* Escondido no mobile por padrão como no original */
    align-items: center;
    gap: 0.5rem;
    color: var(--gray-200); /* Inverte entre dark/light automaticamente */
    text-decoration: none;
    font-weight: 500;
    transition: color var(--theme-transition);
  }

  .back-link:hover,
  .back-link:focus {
    color: var(--accent-regular);
    text-decoration: underline;
    text-decoration-color: var(--accent-regular);
    text-underline-offset: 0.25em;
  }

  /* LAYOUT DETAILS & TAGS */
  .details {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
    text-align: left;
    padding: 0.5rem 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap; /* Impede quebra de layout */
    gap: 0.75rem;
    justify-content: flex-start;
  }

  .description {
    font-size: var(--text-lg);
    max-width: 54ch;
    color: var(--gray-300); /* Cor secundária que respeita o tema */
    margin: 0;
    line-height: 1.5;
  }

  /* RESPONSIVIDADE DESKTOP */
  @media (min-width: 50em) {
    .back-link {
      display: flex;
      align-self: flex-start;
    }

    .details {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 2.5rem;
    }

    .tags {
      flex: 1;
    }

    .description {
      flex: 1.5;
      font-size: var(--text-xl);
    }
  }

  /* CONTEÚDO (MARKDOWN) */
  .content {
    max-width: 65ch;
    margin-inline: auto;
    color: var(--gray-200);
  }

  .content > :global(* + *) {
    margin-top: 1.5rem;
  }

  .content :global(h1),
  .content :global(h2),
  .content :global(h3),
  .content :global(h4),
  .content :global(h5) {
    margin: 2rem 0 1rem;
    color: var(--gray-0); /* Títulos em contraste máximo */
  }

  .content :global(img) {
    border-radius: 1.5rem;
    box-shadow: var(--shadow-sm);
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
    margin: 2rem 0;
  }

  .content :global(blockquote) {
    font-size: var(--text-lg);
    font-family: var(--font-brand);
    font-weight: 600;
    line-height: 1.4;
    padding: 1rem 1.5rem;
    border-inline-start: 0.35rem solid var(--accent-regular);
    background: var(--gradient-subtle);
    color: var(--gray-0);
    border-radius: 0 0.5rem 0.5rem 0;
  }

  /* LINKS DENTRO DO CONTEÚDO */
  .content :global(a) {
    color: var(--accent-regular);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: all var(--theme-transition);
  }

  .content :global(a:hover),
  .content :global(a:focus) {
    color: var(--accent-light);
    text-decoration-color: var(--accent-light);
  }

  @media (min-width: 50em) {
    .content :global(blockquote) {
      font-size: var(--text-2xl);
    }
  }
</style>