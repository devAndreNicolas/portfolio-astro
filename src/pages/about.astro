---
import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About | Andre Nicolas"
  description="Learn more about Andre Nicolas, a Frontend Engineer focused on scalable product systems, UX, and performance.">
  <div class="stack gap-20">
    <main class="wrapper about" style="align-items: center;">
      <Hero
        title="About"
        tagline="Frontend Engineer focused on scalable, high-performance, product-driven systems.">
      </Hero>

      <section>
        <h2 class="section-title">Professional Summary</h2>
        <div class="content">
          <p>
            I am a Frontend Engineer with a product-oriented mindset, focused on
            scalable architecture, performance, and real user outcomes in SaaS
            environments.
          </p>
          <p>
            I have led frontend initiatives, improved team workflows, and
            delivered high-quality experiences across compliance products used by
            more than 10 companies. I also collaborate beyond frontend boundaries
            when needed, contributing to backend solutions in Go to improve
            reliability and automation.
          </p>
        </div>
      </section>

      <section>
        <h2 class="section-title">Experience</h2>
        <div class="content">
          <p>
            <strong>MSPA — Frontend Engineer (Product-Oriented)</strong> (Apr
            2025 – Present)<br />
            Privacy, Compliance (LGPD), and SaaS Platforms
          </p>
          <ul>
            <li>
              Led frontend architecture and product development for core SaaS
              products, including Compass and Trust Center, used by 10+ companies.
            </li>
            <li>
              Designed intuitive UX for complex compliance workflows and applied
              SEO strategy to improve discoverability.
            </li>
            <li>
              Delivered consistently strong Lighthouse performance across
              multiple products.
            </li>
            <li>
              Reorganized development workflow during a critical phase,
              improving sprint clarity, ownership, and team productivity across
              a 6-developer team (4 directly influenced).
            </li>
            <li>
              Built a framework-agnostic consent engine with Web Components
              (Lit + Shadow DOM), integrated with Cloudflare Workers, KV, D1,
              and Durable Objects.
            </li>
            <li>
              Contributed to backend fixes and internal tooling using Go,
              including concurrent processing and internal APIs.
            </li>
          </ul>
        </div>
      </section>

      <section>
        <h2 class="section-title">Selected Projects</h2>
        <div class="content">
          <p>
            <strong>Terto Beats:</strong> Fullstack digital product platform
            (Next.js, Supabase, Vercel) with end-to-end checkout, state
            management, and post-purchase automation.
          </p>
          <p style="margin-top: 0.5rem;">
            <strong>RendeCerto:</strong> Financial web application focused on
            simulation accuracy and reliability, with strong test coverage for
            complex calculation rules.
          </p>
          <p style="margin-top: 0.5rem;">
            <strong>Quebrando Fronteiras:</strong> Refactored critical user
            flows on a social impact platform, improving usability and
            conversion-related interactions.
          </p>
        </div>
      </section>

      <section>
        <h2 class="section-title">Technical Skills</h2>
        <div class="content">
          <p>
            <strong>Frontend:</strong> Angular (Signals/RxJS), React, Web
            Components (Lit), TypeScript, Tailwind CSS.<br />
            <strong>Architecture:</strong> Scalable systems, design systems
            (Shadow DOM), performance optimization, SEO.<br />
            <strong>Backend Exposure:</strong> Go (concurrency, APIs), debugging
            distributed systems.<br />
            <strong>Cloud & Infra:</strong> Cloudflare Workers, KV, D1, Durable
            Objects, serverless architectures.<br />
            <strong>Testing & QA:</strong> Vitest, CI/CD pipelines,
            reliability-focused engineering.<br />
            <strong>Product & Collaboration:</strong> Product thinking, backlog
            refinement, code review, cross-functional collaboration.
          </p>
        </div>
      </section>

      <section>
        <h2 class="section-title">Education & Languages</h2>
        <div class="content">
          <p>
            <strong>Internet Systems</strong> — UNCISAL (Expected 2026)<br />
            <strong>Portuguese:</strong> Native | <strong>English:</strong>
            Professional Working Proficiency (in progress)
          </p>
        </div>
      </section>

      <section>
        <h2 class="section-title">Location & Contact</h2>
        <div class="content">
          <p>
            <strong>Location:</strong> Maceio, AL, Brazil<br />
            <strong>Email:</strong>
            <a href="mailto:devandrenicolas@gmail.com">devandrenicolas@gmail.com</a><br />
            <strong>GitHub:</strong>
            <a href="https://github.com/devAndreNicolas">github.com/devAndreNicolas</a><br />
            <strong>LinkedIn:</strong>
            <a href="https://www.linkedin.com/in/devandrenicolas">linkedin.com/in/devandrenicolas</a>
          </p>
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  img {
    margin-top: 1.5rem;
    border-radius: 1.5rem;
    box-shadow: var(--shadow-md);
    max-width: 100%;
    height: auto;
    display: block;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 50em) {
    img {
      width: 100%;
      max-width: 400px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--gray-300);
  }

  :global(.theme-light) section {
    color: var(--gray-400);
  }

  .section-title {
    grid-column-start: 1;
    font-size: var(--text-xl);
    color: var(--gray-0);
  }

  .content {
    grid-column: 2 / 4;
  }

  .content :global(a) {
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  .content :global(a:hover),
  .content :global(a:focus) {
    text-decoration-color: currentColor;
  }

  .content ul {
    list-style: disc;
    padding-left: 1rem;
  }

  .content li {
    margin-bottom: 0.5rem;
    color: var(--gray-300);
  }

  :global(.theme-light) .content li {
    color: var(--gray-400);
  }

  @media (min-width: 50em) {
    .about {
      display: grid;
      grid-template-columns: 1fr 60% 1fr;
    }

    .about > :global(:first-child) {
      grid-column-start: 2;
    }

    section {
      display: contents;
      font-size: var(--text-lg);
    }
  }
</style>
