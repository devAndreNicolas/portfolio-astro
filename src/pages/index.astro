---
import { getCollection } from "astro:content";
import ProjectPreview from "../components/ProjectPreview.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
const projects = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="André Nicolas — Full Stack Engineer" description="Full Stack Engineer and Software Engineer building product systems across frontend, APIs, data, platform, and AI-enabled experiences.">
  <main>
    <section class="hero wrapper"><p class="eyebrow">André Nicolas · Full Stack Engineer</p><h1 class="display">Product systems,<br />clear experiences.</h1><div class="hero-bottom"><p>I build software across frontend, APIs, data, platform, and AI-enabled workflows—using product context and strong interfaces to make complex work usable.</p><div><a class="button" href="#work">View selected work</a><a class="text-link" href="mailto:devandrenicolas@gmail.com">Let’s talk <span aria-hidden="true">↗</span></a></div></div></section>
    <section class="proof"><div class="wrapper"><span>Frontend Engineer at MSPA</span><span>Full-stack product and systems work</span><span>AI-enabled delivery with engineering judgment</span></div></section>
    <section class="capabilities wrapper" aria-labelledby="capabilities-heading"><header><p class="eyebrow">How I contribute</p><h2 id="capabilities-heading" class="display">A frontend specialty,<br />end-to-end reach.</h2></header><div class="capability-grid"><article><h3>Product systems</h3><p>Angular, React, TypeScript, reusable components, product requirements, accessibility, performance, and clear user flows.</p></article><article><h3>Services &amp; platform</h3><p>Go, REST/internal APIs, SQL/PostgreSQL, migrations, asynchronous processing, Cloudflare services, CI/CD, and production debugging.</p></article><article><h3>AI &amp; engineering practice</h3><p>User-facing Genkit features, structured prompts and responses, plus AI-native exploration, review, testing, and iteration with human technical judgment.</p></article><article><h3>Java foundation</h3><p>Academic Java work, including an Android CRUD project with SQLite and native Android components—clearly scoped as project experience.</p></article></div></section>
    <section id="work" class="work wrapper" aria-labelledby="work-heading"><header><p class="eyebrow">Selected work</p><h2 id="work-heading" class="display">Products, systems<br />and useful tools.</h2><p>Each project is a piece of evidence: the problem, the decisions made, and the experience delivered.</p></header><div>{projects.map((project, index) => <ProjectPreview project={project} index={index + 1} priority={index < 4} />)}</div></section>
    <section class="approach wrapper"><p class="eyebrow">How I work</p><div class="approach-grid"><h2 class="display">Understand the system.<br />Make the product clear.</h2><ol><li><span>01</span> Understand the people, context and constraints.</li><li><span>02</span> Shape an experience around the actual problem.</li><li><span>03</span> Engineer maintainable boundaries and interactions.</li><li><span>04</span> Iterate with the product in use.</li></ol></div></section>
    <section class="contact wrapper"><p class="eyebrow">Let’s build something</p><h2 class="display">Have a product, problem<br />or interesting challenge?</h2><a class="button" href="mailto:devandrenicolas@gmail.com">Get in touch <span aria-hidden="true">↗</span></a></section>
  </main>
</BaseLayout>
<style>
.hero { padding:clamp(5rem, 13vw, 11rem) 0 6rem; }.hero h1 { margin-top:1.25rem; font-size:clamp(3.5rem, 8.2vw, 7.7rem); }.hero-bottom { display:grid; grid-template-columns:minmax(0, 31rem) 1fr; gap:3rem; margin-top:3rem; padding-top:1.5rem; border-top:1px solid var(--line); }.hero-bottom > p { color:var(--muted); font-size:1.12rem; }.hero-bottom div { display:flex; align-items:flex-start; justify-content:flex-end; gap:1.25rem; }.text-link { align-self:center; color:var(--blue); font-size:.86rem; font-weight:700; text-decoration:none; }.text-link:hover { text-decoration:underline; text-underline-offset:.3em; }.proof { border-top:1px solid var(--line); border-bottom:1px solid var(--line); }.proof > div { display:grid; grid-template-columns:repeat(3, 1fr); gap:1rem; padding:1.1rem 0; color:var(--muted); font-size:.76rem; }.proof span + span { border-left:1px solid var(--line); padding-left:1rem; }.capabilities { padding:7rem 0; border-bottom:1px solid var(--line); }.capabilities header { display:grid; grid-template-columns:1fr 1fr; gap:3rem; margin-bottom:3.5rem; }.capabilities h2 { font-size:clamp(2.4rem, 4.5vw, 4.8rem); }.capability-grid { display:grid; grid-template-columns:repeat(4, 1fr); gap:1.25rem; }.capability-grid article { padding-top:1rem; border-top:1px solid var(--line); }.capability-grid h3 { font-size:1rem; }.capability-grid p { margin-top:.75rem; color:var(--muted); font-size:.88rem; line-height:1.55; }.work { padding:8rem 0 3rem; }.work header { display:grid; grid-template-columns:minmax(0, 1fr) minmax(15rem, .55fr); gap:3rem; margin-bottom:4rem; }.work header .eyebrow { grid-column:1 / -1; }.work h2 { grid-column:1; max-width:12ch; font-size:clamp(2.7rem, 5vw, 5.2rem); }.work header > p:last-child { grid-column:2; align-self:end; color:var(--muted); max-width:31ch; font-size:.92rem; }.approach { padding:7rem 0; border-top:1px solid var(--line); }.approach-grid { display:grid; grid-template-columns:1fr 1fr; gap:4rem; margin-top:1rem; }.approach h2 { font-size:clamp(2.4rem, 4vw, 4.6rem); }.approach ol { list-style:none; }.approach li { display:grid; grid-template-columns:3rem 1fr; gap:1rem; padding:1rem 0; border-top:1px solid var(--line); color:var(--muted); font-size:.94rem; }.approach li span { color:var(--blue); font-size:.74rem; font-weight:700; }.contact { padding:7rem 0 8rem; border-top:1px solid var(--line); }.contact h2 { margin:1rem 0 2rem; font-size:clamp(2.7rem, 5.2vw, 5.5rem); } @media(max-width:52rem) { .hero { padding-top:5rem; }.hero-bottom,.capabilities header,.work header,.approach-grid { grid-template-columns:1fr; gap:1.5rem; }.hero-bottom div { justify-content:flex-start; flex-wrap:wrap; }.proof > div,.capability-grid { grid-template-columns:1fr; gap:.8rem; }.proof span + span { border-left:0; padding-left:0; }.capabilities { padding:5rem 0; }.work { padding-top:5rem; }.work header { margin-bottom:2rem; }.work h2,.work header > p:last-child { grid-column:auto; }.approach { padding:5rem 0; }.contact { padding:5rem 0; } }
</style>
