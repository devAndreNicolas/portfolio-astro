---
import { getCollection } from "astro:content";
import ProjectPreview from "../components/ProjectPreview.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
const projects = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout>
  <main>
    <section class="hero wrapper"><p class="eyebrow">André Nicolas · Frontend Engineer</p><h1 class="display">At the intersection of<br />UX, Product &amp; Engineering.</h1><div class="hero-bottom"><p>I build digital products that turn complex problems into clear experiences people can actually understand and use.</p><div><a class="button" href="#work">View selected work</a><a class="text-link" href="mailto:devandrenicolas@gmail.com">Let’s talk <span aria-hidden="true">↗</span></a></div></div></section>
    <section class="proof"><div class="wrapper"><span>Currently building software at MSPA</span><span>Product · UX · Frontend architecture · Engineering</span><span>Frontend specialist with full-stack reach</span></div></section>
    <section id="work" class="work wrapper" aria-labelledby="work-heading"><header><p class="eyebrow">Selected work</p><h2 id="work-heading" class="display">Products, systems<br />and useful tools.</h2><p>Each project is a piece of evidence: the problem, the decisions made, and the experience delivered.</p></header><div>{projects.map((project, index) => <ProjectPreview project={project} index={index + 1} priority={index < 4} />)}</div></section>
    <section class="approach wrapper"><p class="eyebrow">How I work</p><div class="approach-grid"><h2 class="display">Understand the system.<br />Make the product clear.</h2><ol><li><span>01</span> Understand the people, context and constraints.</li><li><span>02</span> Shape an experience around the actual problem.</li><li><span>03</span> Engineer maintainable boundaries and interactions.</li><li><span>04</span> Iterate with the product in use.</li></ol></div></section>
    <section class="contact wrapper"><p class="eyebrow">Let’s build something</p><h2 class="display">Have a product, problem<br />or interesting challenge?</h2><a class="button" href="mailto:devandrenicolas@gmail.com">Get in touch <span aria-hidden="true">↗</span></a></section>
  </main>
</BaseLayout>
<style>
.hero { padding:clamp(5rem, 13vw, 11rem) 0 6rem; }.hero h1 { margin-top:1.25rem; font-size:clamp(3.5rem, 8.2vw, 7.7rem); }.hero-bottom { display:grid; grid-template-columns:minmax(0, 31rem) 1fr; gap:3rem; margin-top:3rem; padding-top:1.5rem; border-top:1px solid var(--line); }.hero-bottom > p { color:var(--muted); font-size:1.12rem; }.hero-bottom div { display:flex; align-items:flex-start; justify-content:flex-end; gap:1.25rem; }.text-link { align-self:center; color:var(--blue); font-size:.86rem; font-weight:700; text-decoration:none; }.text-link:hover { text-decoration:underline; text-underline-offset:.3em; }.proof { border-top:1px solid var(--line); border-bottom:1px solid var(--line); }.proof > div { display:grid; grid-template-columns:repeat(3, 1fr); gap:1rem; padding:1.1rem 0; color:var(--muted); font-size:.76rem; }.proof span + span { border-left:1px solid var(--line); padding-left:1rem; }.work { padding:8rem 0 3rem; }.work header { display:grid; grid-template-columns:minmax(0, 1fr) minmax(15rem, .55fr); gap:3rem; margin-bottom:4rem; }.work header .eyebrow { grid-column:1 / -1; }.work h2 { grid-column:1; max-width:12ch; font-size:clamp(2.7rem, 5vw, 5.2rem); }.work header > p:last-child { grid-column:2; align-self:end; color:var(--muted); max-width:31ch; font-size:.92rem; }.approach { padding:7rem 0; border-top:1px solid var(--line); }.approach-grid { display:grid; grid-template-columns:1fr 1fr; gap:4rem; margin-top:1rem; }.approach h2 { font-size:clamp(2.4rem, 4vw, 4.6rem); }.approach ol { list-style:none; }.approach li { display:grid; grid-template-columns:3rem 1fr; gap:1rem; padding:1rem 0; border-top:1px solid var(--line); color:var(--muted); font-size:.94rem; }.approach li span { color:var(--blue); font-size:.74rem; font-weight:700; }.contact { padding:7rem 0 8rem; border-top:1px solid var(--line); }.contact h2 { margin:1rem 0 2rem; font-size:clamp(2.7rem, 5.2vw, 5.5rem); } @media(max-width:52rem) { .hero { padding-top:5rem; }.hero-bottom,.work header,.approach-grid { grid-template-columns:1fr; gap:1.5rem; }.hero-bottom div { justify-content:flex-start; flex-wrap:wrap; }.proof > div { grid-template-columns:1fr; gap:.5rem; }.proof span + span { border-left:0; padding-left:0; }.work { padding-top:5rem; }.work header { margin-bottom:2rem; }.work h2,.work header > p:last-child { grid-column:auto; }.approach { padding:5rem 0; }.contact { padding:5rem 0; } }
</style>
