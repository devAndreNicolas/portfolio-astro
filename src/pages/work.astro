---
import { getCollection } from "astro:content";
import ContactCTA from "../components/ContactCTA.astro";
import Grid from "../components/Grid.astro";
import Hero from "../components/Hero.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("work")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
  title="Meus Projetos | André Nicolas"
  description="Explore os projetos em destaque de André Nicolas em engenharia frontend, liderança de produto e sistemas escaláveis.">
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero
        title="Meus Projetos"
        tagline="Projetos de alto impacto em compliance, fintech e engenharia de produto. Soluções projetadas para resolver problemas reais em escala."
        align="start"
      />
      <Grid variant="offset">
        {
          projects.map((project) => (
            <li>
              <PortfolioPreview project={project} />
            </li>
          ))
        }
      </Grid>
    </main>
    <ContactCTA />
  </div>
</BaseLayout>
