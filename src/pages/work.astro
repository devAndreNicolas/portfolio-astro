---
import { getCollection, type CollectionEntry } from "astro:content";
import ContactCTA from "../components/ContactCTA.astro";
import Grid from "../components/Grid.astro";
import Hero from "../components/Hero.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects: CollectionEntry<"work">[] = (await getCollection("work")).sort(
  (a: CollectionEntry<"work">, b: CollectionEntry<"work">) =>
    b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
  title="Projects | Andre Nicolas"
  description="Explore featured work by Andre Nicolas across frontend engineering, product development, and scalable systems.">
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero
        title="Projects"
        tagline="Selected case studies across compliance SaaS, fintech, and product engineering, with recent MSPA work focused on LGPD UX, consent enforcement, and scalable frontend architecture."
        align="start"
      />
      <Grid variant="offset">
        {
          projects.map((project) => (
            <li>
              <PortfolioPreview project={project} />
            </li>
          ))
        }
      </Grid>
    </main>
    <ContactCTA />
  </div>
</BaseLayout>
