---
import Icon from "./Icon.astro";
---

<section class="skills">
  <div class="skill-card">
    <div class="skill-header">
      <Icon
        icon="gauge"
        color="var(--accent-regular)"
        size="2.5rem"
        gradient
      />
      <h2>Scalable Frontend Systems</h2>
    </div>
    <p>
      Frontend engineer focused on <strong>Angular, React, and TypeScript</strong>.
      I build scalable interfaces with strong UX foundations, measurable
      performance, and reliable delivery standards.
    </p>
  </div>

  <div class="skill-card">
    <div class="skill-header">
      <Icon
        icon="cloud-sun"
        color="var(--accent-regular)"
        size="2.5rem"
        gradient
      />
      <h2>Edge & Cloud Infrastructure</h2>
    </div>
    <p>
      Practical experience with <strong>Cloudflare Workers, KV, D1, and Durable Objects</strong>
      to support low-latency, serverless architectures for compliance and SaaS products.
    </p>
  </div>

  <div class="skill-card">
    <div class="skill-header">
      <Icon icon="trophy" color="var(--accent-regular)" size="2.5rem" gradient />
      <h2>Product-Oriented Delivery</h2>
    </div>
    <p>
      Product-minded execution across planning and delivery, including
      backlog refinement, code review, and cross-functional collaboration in
      high-responsibility environments.
    </p>
  </div>
</section>

<style>
  .skills {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .skill-card {
    border: 1px solid var(--gray-800);
    border-radius: 1rem;
    padding: 2rem;
    background: var(--gradient-subtle);
    box-shadow: var(--shadow-sm);
    transition: all var(--theme-transition);
    position: relative;
    overflow: hidden;
  }

  .skill-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--accent-subtle-overlay);
    opacity: 0;
    transition: opacity var(--theme-transition);
    pointer-events: none;
  }

  .skill-card:hover {
    border-color: var(--accent-light);
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
  }

  .skill-card:hover::before {
    opacity: 0.1;
  }

  .skill-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1rem;
    position: relative;
    z-index: 1;
  }

  .skill-card h2 {
    font-size: var(--text-lg);
    margin: 0;
    color: var(--gray-0);
    position: relative;
    z-index: 1;
  }

  .skill-card p {
    color: var(--gray-300);
    position: relative;
    z-index: 1;
    margin: 0;
    line-height: 1.6;
    font-size: var(--text-md);
  }

  .skill-card p strong {
    color: var(--accent-regular);
    font-weight: 600;
  }

  @media (min-width: 50em) {
    .skills {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .skill-card {
      border-radius: 1.5rem;
      padding: 2.5rem;
    }

    .skill-card h2 {
      font-size: var(--text-xl);
    }
  }
</style>
