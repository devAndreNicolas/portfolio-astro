---
interface Category {
  name: string;
  items: string[];
}

const categories: Category[] = [
  {
    name: "Frontend",
    items: [
      "Angular (Signals/RxJS)",
      "React",
      "Web Components (Lit)",
      "TypeScript",
      "Tailwind CSS",
    ],
  },
  {
    name: "Architecture",
    items: [
      "Scalable Systems",
      "Design Systems (Shadow DOM)",
      "Performance Optimization",
      "SEO",
    ],
  },
  {
    name: "Backend Exposure",
    items: [
      "Golang (Concurrency, APIs)",
      "Distributed Systems Debugging",
    ],
  },
  {
    name: "Cloud & Infra",
    items: [
      "Cloudflare Workers",
      "Cloudflare KV",
      "Cloudflare D1",
      "Durable Objects",
      "Serverless",
    ],
  },
  {
    name: "Testing & QA",
    items: ["Vitest", "CI/CD Pipelines", "Reliability in Distributed Environments"],
  },
  {
    name: "Product & Collaboration",
    items: [
      "Product Thinking",
      "Backlog Refinement",
      "Code Review",
      "Cross-Functional Collaboration",
    ],
  },
];
---

<section class="skills-section">
  <div class="skills-header">
    <h2>Technical Skills</h2>
    <p>
      Core technologies and capabilities used to deliver scalable,
      high-performance product systems.
    </p>
  </div>

  <div class="categories-grid">
    {
      categories.map((category) => (
        <div class="category-card">
          <h3 class="category-title">{category.name}</h3>
          <div class="tag-list">
            {category.items.map((item) => <span class="tag">{item}</span>)}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .skills-section {
    width: 100%;
    max-width: 100%;
    padding: 2rem;
  }

  .skills-header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .skills-header h2 {
    font-size: var(--text-2xl);
    color: var(--gray-0);
    margin: 0 0 0.5rem 0;
  }

  .skills-header p {
    color: var(--gray-300);
    font-size: var(--text-sm);
    margin: 0;
  }

  :global(.theme-light) .skills-header p {
    color: var(--gray-400);
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .category-card {
    padding: 1.75rem;
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
    border-radius: 1rem;
    transition: all 0.3s ease;
  }

  .category-card:hover {
    border-color: var(--accent-light);
    box-shadow: var(--shadow-sm);
  }

  .category-title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--gray-0);
    margin: 0 0 1rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--accent-light);
    letter-spacing: 0.01em;
  }

  :global(.theme-light) .category-title {
    color: var(--accent-light);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .tag {
    display: inline-block;
    padding: 0.35rem 0.65rem;
    background: var(--accent-overlay);
    color: var(--accent-dark);
    border: 1px solid var(--accent-regular);
    border-radius: 0.375rem;
    font-size: 0.73rem;
    font-weight: 600;
    font-family: var(--font-mono);
    line-height: 1.3;
  }

  @media (max-width: 45em) {
    .skills-section {
      padding: 1.5rem;
    }

    .skills-header {
      margin-bottom: 2rem;
    }

    .skills-header h2 {
      font-size: var(--text-xl);
    }

    .categories-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .category-card {
      padding: 1.5rem;
    }
  }

  @media (min-width: 50em) and (max-width: 80em) {
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 80em) {
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
