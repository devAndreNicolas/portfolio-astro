---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
---

<a class="card" href={`/work/${id}`}>
	<div class="card-header">
		<span class="title">{data.title}</span>
	</div>
	<div class="card-body">
		<p class="description">{data.description}</p>
	</div>
	<div class="card-footer">
		<div class="tags">
			{data.tags.slice(0, 3).map((tag) => (
				<span class="tag">{tag}</span>
			))}
			{data.tags.length > 3 && (
				<span class="tag">+{data.tags.length - 3}</span>
			)}
		</div>
	</div>
</a>

<style>
    .card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        min-height: 16rem;
        /* USANDO SUAS VARIÁVEIS: O gradient-subtle já inverte no seu global */
        background: var(--gradient-subtle);
        border: 1px solid var(--gray-800);
        border-radius: 0.75rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        text-decoration: none;
        font-family: var(--font-brand);
        transition: all var(--theme-transition);
        padding: 1.25rem;
        gap: 1rem;
        position: relative;
    }

    .card::before {
        content: '';
        position: absolute;
        inset: 0;
        /* Usa o overlay que você definiu para dar o brilho no hover */
        background: var(--accent-subtle-overlay);
        opacity: 0;
        transition: opacity var(--theme-transition);
        pointer-events: none;
    }

    .card:hover {
        box-shadow: var(--shadow-md);
        border-color: var(--accent-light);
        transform: translateY(-4px);
    }

    .card:hover::before {
        opacity: 0.1;
    }

    .title {
        display: block;
        /* gray-0 inverte de preto para branco no seu código */
        color: var(--gray-0);
        font-size: var(--text-lg);
        font-weight: 600;
        line-height: 1.3;
        position: relative;
        z-index: 1;
    }

    .description {
        /* gray-300 é o cinza intermediário que se ajusta */
        color: var(--gray-300);
        font-size: var(--text-sm);
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 0;
        position: relative;
        z-index: 1;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        position: relative;
        z-index: 1;
    }

    .tag {
        display: inline-block;
        padding: 0.35rem 0.65rem;
        /* background dinâmico */
        background: var(--accent-overlay);
        /* AQUI ESTÁ O PULO DO GATO: */
        /* No seu global, --accent-dark fica claro no Dark Mode e escuro no Light Mode. */
        color: var(--accent-dark); 
        border: 1px solid var(--accent-regular);
        border-radius: 0.375rem;
        font-size: 0.7rem;
        font-weight: 600;
        font-family: var(--font-mono);
        white-space: nowrap;
        transition: all var(--theme-transition);
    }

    .card:hover .tag {
        background: var(--accent-regular);
        color: var(--accent-text-over);
    }

    /* Media queries mantidas */
    @media (max-width: 45em) {
        .card { min-height: 14rem; border-radius: 0.5rem; padding: 1rem; }
        .title { font-size: var(--text-base); }
        .tag { padding: 0.25rem 0.5rem; }
    }

    @media (min-width: 50em) {
        .card { min-height: 18rem; border-radius: 1.5rem; padding: 1.75rem; }
        .title { font-size: var(--text-xl); }
    }
</style>